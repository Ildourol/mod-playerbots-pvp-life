# Outland & Northrend hotspots (level 65-80 bracket)
PvPLife.Zone.Shattrath_Outskirts.Enable = 1
PvPLife.Zone.Shattrath_Outskirts.MinPopulation = 4
PvPLife.Zone.Shattrath_Outskirts.MaxPopulation = 10
PvPLife.Zone.K3_StormPeaks.Enable = 1
PvPLife.Zone.K3_StormPeaks.MinPopulation = 4
PvPLife.Zone.K3_StormPeaks.MaxPopulation = 10
PvPLife.Zone.Wintergrasp.Enable = 1
PvPLife.Zone.Wintergrasp.MinPopulation = 6
PvPLife.Zone.Wintergrasp.MaxPopulation = 12

# Lowbie starter perimeter skirmishes (level 5-15 bracket)
PvPLife.Zone.Goldshire_Roaming.Enable = 1
PvPLife.Zone.Goldshire_Roaming.MinPopulation = 3
PvPLife.Zone.Goldshire_Roaming.MaxPopulation = 6
PvPLife.Zone.Durotar_Roaming.Enable = 1
PvPLife.Zone.Durotar_Roaming.MinPopulation = 3
