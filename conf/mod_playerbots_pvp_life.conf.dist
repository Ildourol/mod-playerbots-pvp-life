PvPLife.Zone.Orgrimmar_Zeppelin.Enable = 0
PvPLife.Zone.Orgrimmar_Zeppelin.MinPopulation = 3
PvPLife.Zone.Orgrimmar_Zeppelin.MaxPopulation = 8

# Capital campaign assaults (level 60-80 bracket)
PvPLife.Zone.ForTheHorde_Stormwind.Enable = 1
PvPLife.Zone.ForTheHorde_Stormwind.MinPopulation = 6
